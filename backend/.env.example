# WebGPT Environment Configuration
# Copy this file to .env and fill in your values.

# Required: Your Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Database
DATABASE_URL=sqlite+aiosqlite:///./webgpt.db

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data

# Models
EMBEDDING_MODEL=all-MiniLM-L6-v2
GEMINI_MODEL=gemini-2.5-flash

# Gemini Fallback Model Chain (native JSON array, priority order)
# Models are tried left-to-right.  Transient failures (429/503) place a model
# on cooldown for GEMINI_COOLDOWN_SECONDS so subsequent requests skip it.
GEMINI_MODEL_CHAIN=["gemini-2.5-flash","gemini-3.5-flash","gemini-3-flash","gemini-3.1-flash-lite","gemini-2.5-flash-lite"]
GEMINI_COOLDOWN_SECONDS=60.0

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval
MAX_RETRIEVAL_RESULTS=5
RELEVANCE_THRESHOLD=1.2

# Scraping
SCRAPE_DELAY_SECONDS=1.0
SCRAPE_TIMEOUT_SECONDS=10
SCRAPE_MAX_DEPTH=2
SCRAPE_MAX_PAGES=50

# CORS
CORS_ORIGINS=["http://localhost:5173"]
